    "redis-memory-guard": "node --max-old-space-size=1536 --import tsx scripts/redis-memory-guard.ts",
    "test": "node --import tsx --test src/lib/runRetention.test.ts src/lib/pipelineCompanyJobData.test.ts src/lib/processStatusEmissionsGate.test.ts src/lib/redisMemoryGuard.test.ts src/lib/redis-client.test.ts src/services/RunRetentionService.test.ts src/services/S3UploadService.test.ts src/middleware/auth.test.ts"
  },
